function showStep(name){steps.forEach(function(s){s.classList.toggle('active',s.dataset.step===String(name));});}
function goStep(n){
  cur=n;showStep(n);
  track('assessment_step',{step_number:n,step_of:totalSteps});
  aBar.style.width=Math.round(n/totalSteps*100)+'%';
  aLbl.textContent='Step '+n+' of '+totalSteps;
  aBack.style.visibility=n>1?'visible':'hidden';
  aNext.innerHTML=(n===totalSteps?'Build My Roadmap':'Continue')+' <span class="arrow">\u2192</span>';
  document.querySelector('.assess-card').scrollTop=0;
}
function assessPrev(){if(cur>1)goStep(cur-1);}
function assessNext(){
  // basic validation on step 1
  if(cur===1){
    var fn=document.getElementById('f_first').value.trim();
    var em=document.getElementById('f_email').value.trim();
    if(!fn||!em||em.indexOf('@')<1){alert('Please enter your first name and a valid email to continue.');return;}
  }
  if(cur<totalSteps){goStep(cur+1);}
  else{finish();}
}
function finish(){
  showStep('final');
  aNav.style.display='none';
  aBar.style.width='100%';aLbl.textContent='Complete';
  var fn=document.getElementById('f_first').value.trim();
  document.getElementById('finalName').textContent=(fn?fn+', your roadmap is being built.':'Your roadmap is being built.');
  document.querySelector('.assess-card').scrollTop=0;
  /* GHL: wire this submit to your CRM/webhook. Collected answers are in window.syccoAnswers */
  window.syccoAnswers=collectAnswers();
  track('assessment_complete',{responses:(window.syccoAnswers.responses||[]).length});
  track('generate_lead',{value:1,currency:'USD'});
  submitToGHL(window.syccoAnswers);
}
function collectAnswers(){
  var out={first:val('f_first'),email:val('f_email'),phone:val('f_phone'),sms_consent:document.getElementById('f_sms').checked,sms_consent_text:document.getElementById('f_sms_text').textContent.trim(),sms_consent_at:(document.getElementById('f_sms').checked?new Date().toISOString():''),
    full_name:val('f_first'),source:'SYCCO Roadmap Assessment',page:location.href,
    submitted_at:new Date().toISOString(),responses:[]};
  steps.forEach(function(s){
    if(s.dataset.step==='1'||s.dataset.step==='final')return;
    var qEl=s.querySelector('h3');var q=qEl?qEl.textContent.trim():('Step '+s.dataset.step);
    var picks=[];s.querySelectorAll('.opt.sel').forEach(function(o){picks.push(o.textContent.trim());});
    if(picks.length)out.responses.push({step:s.dataset.step,question:q,answers:picks});
  });
  return out;
}
function val(id){return document.getElementById(id).value.trim();}

/* option selection: multi vs single */
document.querySelectorAll('.opt-grid').forEach(function(grid){
  var single=grid.hasAttribute('data-single');
  grid.querySelectorAll('.opt').forEach(function(o){
    o.addEventListener('click',function(){
      if(single){grid.querySelectorAll('.opt').forEach(function(x){x.classList.remove('sel');});o.classList.add('sel');
