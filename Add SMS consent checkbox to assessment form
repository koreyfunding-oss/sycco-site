/* ============ ROADMAP HERO ANIMATION ("the video") ============ */
(function(){
  var labels=['INCOME','BUSINESS','CREDIT','CAPITAL','DEBT','ASSETS','INVESTMENTS','OPPORTUNITIES','GOALS','STRATEGY'];
  var cx=200,cy=210,R=150,nodes=[],svgNS='http://www.w3.org/2000/svg';
  var g=document.getElementById('rmNodes');
  var N=labels.length;
  for(var i=0;i<N;i++){
    var ang=(-90+ i*(360/N))*Math.PI/180;
    var x=cx+R*Math.cos(ang), y=cy+R*Math.sin(ang);
    nodes.push({x:x,y:y,label:labels[i]});
    var grp=document.createElementNS(svgNS,'g');grp.setAttribute('class','rm-node');grp.setAttribute('data-i',i);
    var core=document.createElementNS(svgNS,'circle');core.setAttribute('cx',x);core.setAttribute('cy',y);core.setAttribute('r',6);core.setAttribute('class','rm-core');
    var t=document.createElementNS(svgNS,'text');t.setAttribute('class','rm-label');
    // place label outside the ring
    var lx=cx+(R+22)*Math.cos(ang), ly=cy+(R+22)*Math.sin(ang)+3;
    if(lx<70)lx=70; if(lx>330)lx=330;
    t.setAttribute('x',lx);t.setAttribute('y',ly);t.textContent=labels[i];
    grp.appendChild(core);grp.appendChild(t);g.appendChild(grp);
  }
  var line=document.getElementById('rmLine');
  var bar=document.getElementById('rmBar'),pct=document.getElementById('rmPct');
  var nodeEls=g.querySelectorAll('.rm-node');
  var started=false;

  function buildPath(upto){
    var d='';
    for(var i=0;i<=upto&&i<N;i++){
      // path from node to center hub creating a connecting web
      var n=nodes[i];
      d+=(i===0?'M':'L')+n.x.toFixed(1)+' '+n.y.toFixed(1)+' ';
      d+='L'+cx+' '+cy+' ';
    }
    return d;
  }

  function run(){
    if(started)return;started=true;
    var i=0;
    var timer=setInterval(function(){
      if(i>=N){
        clearInterval(timer);
        pct.textContent='Roadmap ready';
        // draw full connecting ring outline
        var ring='';
        for(var k=0;k<N;k++){ring+=(k===0?'M':'L')+nodes[k].x.toFixed(1)+' '+nodes[k].y.toFixed(1)+' ';}
        ring+='Z';
        setTimeout(function(){
          line.setAttribute('d',ring);
          line.style.transition='stroke-dashoffset 1.6s ease';
          line.style.strokeDashoffset='0';
        },250);
        // loop restart after a pause
        setTimeout(reset,4200);
        return;
      }
      nodeEls[i].classList.add('lit');
      line.setAttribute('d',buildPath(i));
      line.style.transition='none';
      line.style.strokeDashoffset='0';
      line.style.strokeDasharray='none';
      i++;
      var p=Math.round(i/N*100);
      bar.style.width=p+'%';pct.textContent='Assembling '+p+'%';
    },560);
  }

  function reset(){
    started=false;
    nodeEls.forEach(function(el){el.classList.remove('lit');});
    line.setAttribute('d','');line.style.strokeDasharray='1200';line.style.strokeDashoffset='1200';
    bar.style.width='0';pct.textContent='Assembling…';
    setTimeout(run,400);
  }

  var rio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){run();}});},{threshold:.4});
  rio.observe(document.getElementById('roadmapStage'));
})();

