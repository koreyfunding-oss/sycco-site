<title>SYCCO — Build Your 12-Month Wealth Roadmap</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700;9..144,800;9..144,900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0B1712;          /* near-black emerald */
  --emerald:#0E2019;
  --emerald-2:#14342A;
  --emerald-3:#1B3D31;
  --charcoal:#141614;
  --line:#2B4A3D;
  --ivory:#F6F1E4;
  --ivory-dim:#D9D3C4;
  --parchment:#EFE7D3;
  --gold:#C6A15C;
  --gold-soft:#E7CE9A;
  --gold-bright:#EAD39C;
  --muted:#9DB0A6;
  --muted-dark:#5A6B62;
  --wrap:1200px;
  --pad:clamp(1.2rem,4vw,2.5rem);
  --radius:14px;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;}
body{
  font-family:'Inter',system-ui,sans-serif;
  background:var(--emerald);
  color:var(--ivory);
  line-height:1.6;
  overflow-x:hidden;
}
h1,h2,h3,h4,.display{font-family:'Fraunces',Georgia,serif;font-weight:600;line-height:1.06;letter-spacing:-0.01em;}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
.wrap{max-width:var(--wrap);margin:0 auto;padding:0 var(--pad);}
.eyebrow{
  font-family:'Inter',sans-serif;font-weight:600;font-size:.72rem;
  letter-spacing:.28em;text-transform:uppercase;color:var(--gold);
}
.gold-text{color:var(--gold);}
.serif-accent{font-style:italic;font-weight:400;}

/* ---------- BUTTONS ---------- */
.btn{
  display:inline-flex;align-items:center;gap:.6rem;cursor:pointer;
  font-family:'Inter',sans-serif;font-weight:600;font-size:.98rem;
  letter-spacing:.02em;border:none;border-radius:100px;
  padding:1.05rem 2.3rem;transition:transform .25s ease,box-shadow .25s ease,background .25s ease;
  position:relative;
}
.btn-gold{
  background:linear-gradient(135deg,var(--gold-soft),var(--gold));
  color:#20180A;
  box-shadow:0 10px 40px rgba(198,161,92,0.28);
}
.btn-gold:hover{transform:translateY(-3px);box-shadow:0 16px 55px rgba(198,161,92,0.42);}
.btn-gold .arrow{transition:transform .25s ease;}
.btn-gold:hover .arrow{transform:translateX(5px);}
.btn-ghost{
  background:transparent;color:var(--ivory);
  border:1px solid var(--line);
}
.btn-ghost:hover{border-color:var(--gold);color:var(--gold-soft);}
.micro{color:var(--muted);font-size:.82rem;margin-top:1rem;line-height:1.7;}
.micro strong{color:var(--ivory-dim);font-weight:500;}

/* ---------- REVEAL ANIMATIONS ---------- */
.reveal{opacity:0;transform:translateY(34px);transition:opacity 1s cubic-bezier(.16,.8,.3,1),transform 1s cubic-bezier(.16,.8,.3,1);}
.reveal.in{opacity:1;transform:none;}
.reveal.d1{transition-delay:.1s;}
.reveal.d2{transition-delay:.2s;}
.reveal.d3{transition-delay:.3s;}
.reveal.d4{transition-delay:.4s;}

/* ---------- NAV ---------- */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;transition:background .4s ease,backdrop-filter .4s ease,border-color .4s;border-bottom:1px solid transparent;}
.nav.scrolled{background:rgba(11,23,18,0.82);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:74px;}
.wordmark{font-family:'Fraunces',serif;font-weight:600;font-size:1.5rem;letter-spacing:.04em;}
.wordmark span{color:var(--gold);}
.nav-tag{font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);margin-top:2px;}
.nav-cta{font-size:.8rem;padding:.7rem 1.5rem;}
@media(max-width:600px){.nav-cta{padding:.6rem 1.1rem;font-size:.72rem;}.wordmark{font-size:1.25rem;}}

/* ---------- HERO ---------- */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;padding:120px 0 70px;overflow:hidden;
  background:radial-gradient(120% 90% at 80% 10%,var(--emerald-2) 0%,var(--emerald) 45%,var(--ink) 100%);}
.hero-glow{position:absolute;top:-15%;right:-10%;width:60vw;height:60vw;max-width:760px;max-height:760px;
  background:radial-gradient(circle,rgba(198,161,92,0.16),transparent 62%);filter:blur(20px);pointer-events:none;}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,5vw,4.5rem);align-items:center;position:relative;z-index:2;}
.hero-eyebrow{margin-bottom:1.6rem;}
.hero h1{font-size:clamp(2.6rem,6.2vw,5rem);font-weight:600;margin-bottom:1.5rem;}
.hero h1 .amount{display:block;color:var(--gold);font-weight:700;background:linear-gradient(120deg,var(--gold-soft),var(--gold),var(--gold-bright));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.hero-sub{font-size:clamp(1.05rem,1.9vw,1.32rem);color:var(--ivory-dim);font-weight:400;max-width:42ch;margin-bottom:1.8rem;font-family:'Fraunces',serif;font-style:italic;line-height:1.4;}
.hero-body{color:var(--muted);font-size:.98rem;max-width:44ch;margin-bottom:.6rem;}
.hero-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.4rem 0 2rem;max-width:46ch;}
.hero-chips span{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ivory-dim);
  border:1px solid var(--line);border-radius:100px;padding:.35rem .85rem;background:rgba(27,61,49,0.35);}
.hero-question{font-family:'Fraunces',serif;font-size:1.15rem;color:var(--ivory);margin:0 0 1.8rem;font-weight:500;}
.hero-question .gold-text{font-style:italic;}

/* ---------- ROADMAP ANIMATION (the "video") ---------- */
.roadmap-stage{position:relative;width:100%;aspect-ratio:1/1.02;max-width:520px;margin:0 auto;
  background:linear-gradient(160deg,rgba(20,52,42,0.6),rgba(11,23,18,0.9));
  border:1px solid var(--line);border-radius:20px;overflow:hidden;
  box-shadow:0 40px 90px rgba(0,0,0,0.5),inset 0 1px 0 rgba(231,206,154,0.08);}
.roadmap-stage::before{content:"";position:absolute;inset:0;
  background:radial-gradient(circle at 50% 40%,rgba(198,161,92,0.10),transparent 60%);pointer-events:none;}
.roadmap-head{position:absolute;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;
  padding:14px 18px;font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);z-index:5;
  border-bottom:1px solid rgba(43,74,61,0.6);background:rgba(11,23,18,0.4);}
.roadmap-head .dot{width:7px;height:7px;border-radius:50%;background:var(--gold);box-shadow:0 0 10px var(--gold);display:inline-block;margin-right:7px;animation:livepulse 2s infinite;}
@keyframes livepulse{0%,100%{opacity:1;}50%{opacity:.35;}}
.roadmap-svg{position:absolute;inset:0;width:100%;height:100%;}
.rm-node{opacity:0;}
.rm-node.lit{opacity:1;transition:opacity .5s ease;}
.rm-ring{fill:none;stroke:var(--line);stroke-width:1.2;}
.rm-core{fill:var(--emerald-3);stroke:var(--gold);stroke-width:0;transition:stroke-width .4s ease,fill .4s ease;}
.rm-node.lit .rm-core{stroke-width:1.6;fill:rgba(198,161,92,0.14);}
.rm-label{font-family:'Inter',sans-serif;font-size:9px;font-weight:600;letter-spacing:.12em;fill:var(--ivory-dim);text-transform:uppercase;text-anchor:middle;}
.rm-node.lit .rm-label{fill:var(--gold-soft);}
.rm-line{fill:none;stroke:url(#goldgrad);stroke-width:1.6;stroke-linecap:round;
  stroke-dasharray:1200;stroke-dashoffset:1200;filter:drop-shadow(0 0 3px rgba(198,161,92,0.4));}
.rm-center-label{font-family:'Fraunces',serif;font-size:15px;fill:var(--ivory);text-anchor:middle;font-weight:600;}
.rm-center-sub{font-family:'Inter',sans-serif;font-size:8px;letter-spacing:.18em;fill:var(--gold);text-anchor:middle;text-transform:uppercase;}
.roadmap-foot{position:absolute;bottom:0;left:0;right:0;padding:12px 18px;z-index:5;
  border-top:1px solid rgba(43,74,61,0.6);background:rgba(11,23,18,0.4);display:flex;align-items:center;gap:10px;}
.roadmap-foot .bar{flex:1;height:4px;border-radius:4px;background:rgba(43,74,61,0.7);overflow:hidden;}
.roadmap-foot .bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--gold),var(--gold-soft));border-radius:4px;transition:width .3s linear;}
.roadmap-foot .pct{font-size:.62rem;letter-spacing:.14em;color:var(--gold-soft);font-weight:600;min-width:78px;text-align:right;}

/* ---------- SECTION SHELL ---------- */
section{position:relative;}
.pad{padding:clamp(4.5rem,10vw,8rem) 0;}
.section-eyebrow{margin-bottom:1.4rem;}
.h-lg{font-size:clamp(2rem,4.6vw,3.5rem);font-weight:600;}
.h-md{font-size:clamp(1.7rem,3.4vw,2.6rem);}
.lede{color:var(--ivory-dim);font-size:clamp(1.02rem,1.5vw,1.18rem);max-width:60ch;}
.txt-narrow{max-width:56ch;}
.center{text-align:center;margin-left:auto;margin-right:auto;}

/* ---------- PROBLEM (sec2) ---------- */
.problem{background:linear-gradient(180deg,var(--ink),var(--emerald));}
.stmt-list{margin:2rem 0;display:grid;gap:.5rem;}
.stmt-list p{color:var(--muted);font-size:1.05rem;}
.scatter{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin:2.4rem 0;}
.scatter span{border:1px solid var(--line);border-radius:10px;padding:.9rem 1rem;font-size:.82rem;
  letter-spacing:.06em;text-transform:uppercase;color:var(--muted);background:rgba(27,61,49,0.25);text-align:center;}
@media(max-width:600px){.scatter{grid-template-columns:repeat(2,1fr);}}
.big-statement{text-align:center;padding:clamp(3rem,7vw,5.5rem) 0;}
.big-statement .h-lg{max-width:20ch;margin:0 auto;}
.big-statement .accent{color:var(--gold);display:block;margin-top:.4rem;font-style:italic;font-weight:400;}

/* ---------- OPPORTUNITY DASHBOARD (sec3) ---------- */
.dash{background:var(--ink);}
.dash-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem;}
@media(max-width:820px){.dash-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:480px){.dash-grid{grid-template-columns:1fr;}}
.dash-card{position:relative;border:1px solid var(--line);border-radius:12px;padding:1.3rem 1.3rem;
  background:linear-gradient(160deg,rgba(27,61,49,0.4),rgba(11,23,18,0.5));
  display:flex;align-items:center;gap:.9rem;transition:transform .35s ease,border-color .35s ease,box-shadow .35s ease;overflow:hidden;}
.dash-card:hover{transform:translateY(-4px);border-color:var(--gold);box-shadow:0 18px 40px rgba(0,0,0,0.35);}
.dash-card .ic{width:30px;height:30px;flex-shrink:0;color:var(--gold);}
.dash-card .ic svg{width:100%;height:100%;stroke:currentColor;fill:none;stroke-width:1.6;}
.dash-card h4{font-family:'Inter',sans-serif;font-weight:600;font-size:.86rem;letter-spacing:.05em;text-transform:uppercase;color:var(--ivory);}

/* ---------- STEPS (sec4) ---------- */
.steps{background:linear-gradient(180deg,var(--emerald),var(--ink));}
.steps-wrap{margin-top:3rem;position:relative;}
.step{display:grid;grid-template-columns:auto 1fr;gap:1.8rem;padding:1.8rem 0;border-top:1px solid var(--line);align-items:start;}
.step:last-child{border-bottom:1px solid var(--line);}
.step-num{font-family:'Fraunces',serif;font-size:clamp(2rem,4vw,3rem);color:var(--gold);font-weight:300;line-height:1;min-width:80px;}
.step-body h3{font-size:1.3rem;margin-bottom:.5rem;color:var(--ivory);}
.step-body p{color:var(--muted);max-width:60ch;}

/* ---------- BIG IDEA (sec5) ---------- */
.bigidea{background:radial-gradient(120% 100% at 50% 0%,var(--emerald-2),var(--ink) 70%);text-align:center;}
.bigidea .h-lg{max-width:16ch;margin:0 auto 2.5rem;}
.reveal-lines{max-width:36ch;margin:0 auto;display:grid;gap:.9rem;}
.reveal-lines p{color:var(--ivory-dim);font-size:1.08rem;padding-left:1.6rem;position:relative;text-align:left;}
.reveal-lines p::before{content:"";position:absolute;left:0;top:.65em;width:9px;height:9px;border-radius:50%;
  background:var(--gold);box-shadow:0 0 10px rgba(198,161,92,0.6);}
.bigidea-close{margin-top:3.2rem;}
.bigidea-close .h-md{max-width:22ch;margin:0 auto;}
.bigidea-close .accent{color:var(--gold);font-style:italic;font-weight:400;}

/* ---------- VALUE / 12MO (sec6) ---------- */
.value{background:var(--emerald);}
.value-nums{display:flex;flex-wrap:wrap;justify-content:center;gap:clamp(1rem,4vw,3rem);margin:2.6rem 0 1rem;}
.value-nums .n{font-family:'Fraunces',serif;font-weight:700;font-size:clamp(2rem,5vw,3.6rem);
  background:linear-gradient(120deg,var(--gold-soft),var(--gold));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.two-col-list{columns:2;column-gap:2.5rem;max-width:800px;margin:2rem auto 0;}
@media(max-width:600px){.two-col-list{columns:1;}}
.two-col-list li{list-style:none;color:var(--muted);padding:.5rem 0 .5rem 1.5rem;position:relative;break-inside:avoid;font-size:.96rem;}
.two-col-list li::before{content:"—";position:absolute;left:0;color:var(--gold);}
.disclosure{color:var(--muted-dark);font-size:.75rem;max-width:70ch;margin:2.5rem auto 0;text-align:center;line-height:1.6;}

/* ---------- DIFFERENCE (sec7) ---------- */
.diff{background:linear-gradient(180deg,var(--ink),var(--emerald));text-align:center;}
.diff .h-lg{max-width:18ch;margin:0 auto 1.6rem;}
.diff .h-lg .g{color:var(--gold);font-style:italic;font-weight:400;}
.idea-cloud{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;max-width:640px;margin:2.2rem auto;}
.idea-cloud span{color:var(--muted);font-size:.9rem;border:1px solid var(--line);border-radius:100px;padding:.45rem 1.1rem;background:rgba(27,61,49,0.2);}
.diff-close{font-family:'Fraunces',serif;font-size:clamp(1.5rem,3vw,2.3rem);max-width:20ch;margin:2.5rem auto 0;color:var(--ivory);}
.diff-close .g{color:var(--gold);}

/* ---------- FEATURES (sec8) ---------- */
.feat{background:var(--ink);}
.feat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:3rem;}
@media(max-width:900px){.feat-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:520px){.feat-grid{grid-template-columns:1fr;}}
.feat-card{border:1px solid var(--line);border-radius:12px;padding:1.5rem 1.3rem;
  background:linear-gradient(160deg,rgba(27,61,49,0.35),rgba(11,23,18,0.55));
  backdrop-filter:blur(6px);transition:transform .35s ease,border-color .35s ease;}
.feat-card:hover{transform:translateY(-5px);border-color:var(--gold);}
.feat-card .ic{width:26px;height:26px;color:var(--gold);margin-bottom:.9rem;}
.feat-card .ic svg{width:100%;height:100%;stroke:currentColor;fill:none;stroke-width:1.6;}
.feat-card h4{font-family:'Inter',sans-serif;font-weight:600;font-size:.9rem;letter-spacing:.03em;color:var(--ivory);text-transform:uppercase;}
.feat-close{text-align:center;margin-top:3rem;}
.feat-close p{color:var(--ivory-dim);font-size:1.1rem;max-width:44ch;margin:.3rem auto 0;font-family:'Fraunces',serif;}
.feat-close .g{color:var(--gold);}

/* ---------- PERSONALIZATION (sec9) ---------- */
.pers{background:linear-gradient(180deg,var(--emerald),var(--ink));}
.pers-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4rem);align-items:center;}
@media(max-width:800px){.pers-grid{grid-template-columns:1fr;}}
.pers-list{display:grid;gap:.55rem;margin-top:1.5rem;}
.pers-list p{color:var(--muted);padding-left:1.4rem;position:relative;}
.pers-list p::before{content:"✓";position:absolute;left:0;color:var(--gold);font-size:.85rem;}
.pers-center{font-family:'Fraunces',serif;font-size:clamp(1.4rem,2.6vw,2rem);color:var(--ivory);margin-top:2rem;}
.pers-center .g{color:var(--gold);font-style:italic;}

/* ---------- CONVERSION CTA (sec10) ---------- */
.conv{position:relative;background:radial-gradient(130% 110% at 50% 0%,var(--emerald-2),var(--ink) 65%);text-align:center;overflow:hidden;}
.conv-glow{position:absolute;top:-20%;left:50%;transform:translateX(-50%);width:80vw;max-width:900px;height:600px;
  background:radial-gradient(circle,rgba(198,161,92,0.14),transparent 60%);filter:blur(30px);pointer-events:none;}
.conv .inner{position:relative;z-index:2;max-width:760px;margin:0 auto;}
.conv .h-lg{margin-bottom:1.6rem;}
.conv .lede{margin:0 auto 1.2rem;}
.conv-tag{font-family:'Fraunces',serif;font-style:italic;font-size:clamp(1.2rem,2.4vw,1.7rem);color:var(--gold-soft);margin:1.4rem auto 2.2rem;}

/* ---------- ASSESSMENT MODAL (sec11) ---------- */
.assess-overlay{position:fixed;inset:0;z-index:200;display:none;align-items:center;justify-content:center;
  background:rgba(6,14,10,0.86);backdrop-filter:blur(10px);padding:1.2rem;}
.assess-overlay.show{display:flex;animation:fadeIn .35s ease;}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
.assess-card{width:100%;max-width:620px;background:linear-gradient(165deg,var(--emerald-2),var(--ink));
  border:1px solid var(--line);border-radius:20px;padding:clamp(1.6rem,4vw,2.8rem);position:relative;
  box-shadow:0 40px 100px rgba(0,0,0,0.6);max-height:92vh;overflow-y:auto;animation:slideUp .45s cubic-bezier(.16,.8,.3,1);}
@keyframes slideUp{from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:none;}}
.assess-close{position:absolute;top:1.1rem;right:1.2rem;background:none;border:none;color:var(--muted);
  font-size:1.5rem;cursor:pointer;line-height:1;transition:color .2s;}
.assess-close:hover{color:var(--gold);}
.assess-progress{display:flex;align-items:center;gap:.8rem;margin-bottom:1.8rem;}
.assess-progress .track{flex:1;height:5px;border-radius:5px;background:rgba(43,74,61,0.7);overflow:hidden;}
.assess-progress .track i{display:block;height:100%;width:14%;background:linear-gradient(90deg,var(--gold),var(--gold-soft));border-radius:5px;transition:width .5s cubic-bezier(.16,.8,.3,1);}
.assess-progress .lbl{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-soft);font-weight:600;white-space:nowrap;}
.assess-step{display:none;animation:fadeIn .4s ease;}
.assess-step.active{display:block;}
.assess-step .eyebrow{margin-bottom:.7rem;}
.assess-step h3{font-size:clamp(1.4rem,3vw,1.9rem);margin-bottom:.5rem;color:var(--ivory);}
.assess-step .sub{color:var(--muted);font-size:.95rem;margin-bottom:1.6rem;}
.field{margin-bottom:1.1rem;text-align:left;}
.field label{display:block;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ivory-dim);margin-bottom:.45rem;font-weight:600;}
.field input,.field select{width:100%;background:rgba(11,23,18,0.7);border:1px solid var(--line);border-radius:10px;
  padding:.9rem 1rem;color:var(--ivory);font-family:'Inter',sans-serif;font-size:1rem;transition:border-color .2s;}
.field input:focus,.field select:focus{outline:none;border-color:var(--gold);}
.field input::placeholder{color:var(--muted-dark);}
.field .consent-row{display:flex;gap:.7rem;align-items:flex-start;text-transform:none;letter-spacing:normal;font-weight:400;font-size:.78rem;line-height:1.55;color:var(--ivory-dim);cursor:pointer;margin-bottom:0;}
.field .consent-row input{width:auto;flex:none;margin-top:.2rem;padding:0;accent-color:var(--gold);}
.field .consent-row a{color:var(--gold);text-decoration:underline;}

.opt-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;text-align:left;}
@media(max-width:480px){.opt-grid{grid-template-columns:1fr;}}
.opt{border:1px solid var(--line);border-radius:10px;padding:.85rem 1rem;cursor:pointer;font-size:.9rem;
  color:var(--ivory-dim);background:rgba(11,23,18,0.5);transition:all .2s;display:flex;align-items:center;gap:.6rem;}
.opt:hover{border-color:var(--gold-soft);}
.opt.sel{border-color:var(--gold);background:rgba(198,161,92,0.12);color:var(--gold-soft);}
.opt .box{width:16px;height:16px;border:1.5px solid var(--muted-dark);border-radius:5px;flex-shrink:0;transition:all .2s;position:relative;}
.opt.sel .box{border-color:var(--gold);background:var(--gold);}
