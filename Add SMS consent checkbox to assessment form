/* Auto-open the LeadConnector chat widget ~1.5s after landing */
(function(){
  var DELAY=1500, opened=false, tries=0;
  function getLauncher(){
    var cw=document.querySelector('chat-widget');
    if(cw&&cw.shadowRoot){
      // the round bubble launcher that expands the full chat window
      return cw.shadowRoot.querySelector('#lc_text-widget--btn')
          || cw.shadowRoot.querySelector('.lc_text-widget--bubble');
    }
    return null;
  }
  function tryOpen(){
    if(opened)return;
    tries++;
    var launcher=getLauncher();
    var cw=document.querySelector('chat-widget');
    // only click when widget is loaded and not already open
    if(launcher && cw && cw.getAttribute('data-active')!=='true'){
      launcher.click();opened=true;return;
    }
    if(launcher && cw && cw.getAttribute('data-active')==='true'){opened=true;return;}
    if(tries<40)setTimeout(tryOpen,500); // retry up to ~20s while widget loads
  }
  window.addEventListener('load',function(){setTimeout(tryOpen,DELAY);});
})();
